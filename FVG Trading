void Bullish_FVG()
   {
      double current_High = iHigh(NULL,PERIOD_M15,1);
      double current_Open = iOpen(NULL,PERIOD_M15,1);
      double current_Close = iClose(NULL,PERIOD_M15,1);
      double current_Low = iLow(NULL,PERIOD_M15,1);
      double BTN_High = iHigh(NULL,PERIOD_M15,2);
      double Previous_High = iHigh(NULL,PERIOD_M15,3);
      double Previous_Low = iLow(NULL,PERIOD_M15,3);
      
      double StopLoss = Previous_Low;
      double TakeProfit = current_High;
      
      string comment = "Buy trade";
      
      if (Previous_High < current_Low)
         {
            if (current_Close >= current_Open && current_Close <= BTN_High && (current_High-current_Close)/(current_Open-current_Low) >= 2.0)
               {
                  Trade.BuyLimit(lotsize, current_Low, NULL, StopLoss, TakeProfit, ORDER_TIME_GTC, 1);
                  Trade.BuyLimit(lotsize, current_Low, NULL, StopLoss, TakeProfit, ORDER_TIME_GTC, 2);
               }
            else if (current_Open >= current_Close && current_Close <= BTN_High && (current_High-current_Open)/(current_Close-current_Low) >= 2.0)
               {                  
                  Trade.BuyLimit(lotsize, current_Low, NULL, StopLoss, TakeProfit, ORDER_TIME_GTC, 3);
                  Trade.BuyLimit(lotsize, current_Low, NULL, StopLoss, TakeProfit, ORDER_TIME_GTC, 4);
               }
            else Print("Not a good Bullish Fair value Gap");
         }
   }
   
   
void Bearish_FVG()
   {
      double current_High = iHigh(NULL,PERIOD_M15,1);
      double current_Open = iOpen(NULL,PERIOD_M15,1);
      double current_Close = iClose(NULL,PERIOD_M15,1);
      double current_Low = iLow(NULL,PERIOD_M15,1);
      double BTN_Low = iLow(NULL,PERIOD_M15,2);
      double Previous_High = iHigh(NULL,PERIOD_M15,3);
      double Previous_Low = iLow(NULL,PERIOD_M15,3);
      
      double StopLoss = Previous_High;
      double TakeProfit = current_Low; 
      
      string comment = "Sell trade";
      
      if (Previous_Low > current_High)
         {
            if (current_Open >= current_Close && current_Close >= BTN_Low && (current_Low-current_Close)/(current_Open-current_High) >= 2.0)
               {
                  Trade.SellLimit(lotsize, current_High, NULL, StopLoss, TakeProfit, ORDER_TIME_GTC, 1);
                  Trade.SellLimit(lotsize, current_High, NULL, StopLoss, TakeProfit, ORDER_TIME_GTC, 2);
               }
            else if (current_Close >= current_Open && current_Close >= BTN_Low && (current_Low-current_Open)/(current_Close-current_High) >= 2.0)
               {          
                  Trade.SellLimit(lotsize, current_High, NULL, StopLoss, TakeProfit, ORDER_TIME_GTC, 3);
                  Trade.SellLimit(lotsize, current_High, NULL, StopLoss, TakeProfit, ORDER_TIME_GTC, 4); 
               }
            else Print("Not a good bearish Fair value gap");
         }
   }
