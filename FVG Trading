//+------------------------------------------------------------------+
void OnTick()
  {
//---
   if (Daily_bias_value == 1)
      {
         Bullish_FVG();
      }
   else if (Daily_bias_value == 2)
      {
         Bearish_FVG();
      }
   else
     {
      Print("Daily bias is wrong");
     }
  }
